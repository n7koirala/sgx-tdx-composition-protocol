# Gramine Manifest — PCR-10 Replay Incremental Attestation Subscriber
#
# Mirrors sgx-tdx-attestation/sgx-verifier/verifier.manifest.template
# but mounts the incremental_attestation_PCR10/ folder at /benchmark
# (instead of incremental_attestation/), so the trusted_files hash covers
# the PCR-replay version of benchmark_incremental.py + ima_pcr_verify.py.

libos.entrypoint = "{{ python_path }}"

loader.log_level  = "{{ log_level }}"
loader.insecure__use_cmdline_argv = true

loader.env.LD_LIBRARY_PATH = "/lib:{{ arch_libdir }}:/usr/lib:/usr/{{ arch_libdir }}"
loader.env.PATH  = "/bin:/usr/bin"
loader.env.HOME  = "/home/user"
loader.env.PYTHONPATH = "/app:/app/common:/benchmark"

fs.mounts = [
    { path = "/lib", uri = "file:{{ gramine.runtimedir() }}" },
    { path = "{{ arch_libdir }}",           uri = "file:{{ arch_libdir }}" },
    { path = "/usr/{{ arch_libdir }}",      uri = "file:/usr/{{ arch_libdir }}" },
    { path = "/usr/lib",                    uri = "file:/usr/lib" },

    { path = "{{ python_path }}",                   uri = "file:{{ python_path }}" },
    { path = "/usr/lib/python{{ python_version }}", uri = "file:/usr/lib/python{{ python_version }}" },
    { path = "/usr/lib/python3/dist-packages",      uri = "file:/usr/lib/python3/dist-packages" },
    { path = "/usr/lib/python3",                    uri = "file:/usr/lib/python3" },

    { path = "/etc", uri = "file:/etc" },

    # Application (common/protocol.py lives here)
    { path = "/app", uri = "file:{{ app_dir }}" },

    # PCR-10 variant of the incremental attestation subscriber.
    { path = "/benchmark", uri = "file:{{ bench_dir }}" },

    { type = "tmpfs", path = "/tmp" },
]

# ─── SGX ──────────────────────────────────────────────────────────────────────

sgx.remote_attestation = "dcap"
sgx.debug              = true
sgx.enclave_size       = "2G"
sgx.max_threads        = 32
sgx.isvprodid          = 1
sgx.isvsvn             = 0

sys.insecure__allow_eventfd = true
sys.stack.size              = "2M"
sys.enable_sigterm_injection = true
sys.enable_extra_runtime_domain_names_conf = true

sgx.trusted_files = [
    "file:{{ python_path }}",
    "file:{{ gramine.runtimedir() }}/",
    "file:{{ arch_libdir }}/",
    "file:/usr/{{ arch_libdir }}/",
    "file:/usr/lib/python{{ python_version }}/",
    "file:/usr/lib/python3/dist-packages/",
    "file:/usr/lib/python3/",

    # Common protocol + verifier helpers (reused from the main app).
    "file:{{ app_dir }}/common/",
    "file:{{ app_dir }}/sgx-verifier/",

    # PCR-10 benchmark scripts — measured into MRENCLAVE.
    "file:{{ bench_dir }}/benchmark_incremental.py",
    "file:{{ bench_dir }}/ima_pcr_verify.py",

    "file:/etc/ssl/certs/",
    "file:/usr/share/ca-certificates/",
]

sgx.allowed_files = [
    "file:/etc/nsswitch.conf",
    "file:/etc/host.conf",
    "file:/etc/resolv.conf",
    "file:/etc/hosts",
    "file:/etc/localtime",
    "file:/etc/passwd",
    "file:/etc/group",
    "file:/etc/gai.conf",

    "file:{{ app_dir }}/certs/",

    # Results CSVs written from inside the enclave.  These must pre-exist
    # (`touch`-created by the parent Makefile) because Gramine refuses to
    # create new files under allowed_files paths.
    "file:{{ bench_dir }}/results_point_sgx_pcr.csv",
    "file:{{ bench_dir }}/results_optimized_sgx_pcr.csv",
]
