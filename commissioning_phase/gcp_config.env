# GCP Configuration for CVM Commissioning Phase
# Copy this file to gcp_config.env and fill in your values.

# --- GCP Project ---
GCP_PROJECT_ID=braided-hangout-472219-a5

# --- Location ---
# TDX VMs (C3 series) are available in select zones.
# Check: gcloud compute machine-types list --filter="name=c3-standard-4" --zones
GCP_ZONE=us-central1-a
GCP_REGION=us-central1

# --- Networking ---
GCP_NETWORK=default
GCP_SUBNET=default

# --- Service Account ---
# Path to a service account key JSON file.
# Leave empty if running on a GCP VM with an attached service account.
GCP_SERVICE_ACCOUNT_KEY=

# --- CVM Configuration ---
# Ubuntu 22.04 image (TDX-capable)
VM_IMAGE_PROJECT=ubuntu-os-cloud
VM_IMAGE_FAMILY=ubuntu-2204-lts

# C3 machine type (Intel TDX capable)
VM_MACHINE_TYPE=c3-standard-4

# Username for SSH access to the CVM
VM_USERNAME=cvm

# Prefix for naming GCP resources
PREFIX=sgx-tdx
